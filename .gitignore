# Environment variables
.env
.env.*
!.env.example

# Rails credentials
/config/master.key

# Logs
/log/*
!/log/.keep

# Temporary files
/tmp/*
!/tmp/.keep

# Database
/db/*.sqlite3
/db/*.sqlite3-*

# Storage
/storage/*
!/storage/.keep
# Ignore key files for decrypting credentials and more.
/config/*.key
# End of ignored credential keys.
